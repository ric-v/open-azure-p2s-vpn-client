# Pinned third-party inputs. build.sh refuses anything whose SHA-256 differs.

OPENVPN_VERSION=2.7.8
OPENVPN_URL=https://swupdate.openvpn.org/community/releases/openvpn-2.7.8.tar.gz
OPENVPN_SHA256=c070d1d2440b5a6fca6c2c68645c98cd492116ac36ef4f0946177115532c8e36

OPENSSL_VERSION=3.5.9
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a

# Public header of the TAP-Windows6 driver, needed to compile OpenVPN for Windows.
TAP_HEADER_URL=https://raw.githubusercontent.com/OpenVPN/tap-windows6/master/src/tap-windows.h
TAP_HEADER_SHA256=0b9ea5e4b4dc2c2764fde3383440af9a11a1ead3f2a4bbec674be40da384d10e

# Official signed OpenVPN installer. P2S VPN setup uses it only to install the
# TAP-Windows6 driver and tapctl.exe (ADDLOCAL=OpenVPN,Drivers,Drivers.TAPWindows6).
OPENVPN_MSI_URL=https://swupdate.openvpn.org/community/releases/OpenVPN-2.7.8-I002-amd64.msi
OPENVPN_MSI_SHA256=33104dd02c48cba172612882b1af6276422b1b4340d4c9c84dd2afb4b356fe9f

# OpenVPN patch from the OpenP2S project (GPL-2.0-only), see openvpn/README.md.
PATCH_SHA256=a0a934656b95c9f5d1b6ee0900a1f0e925cadf005d37064f83d639ddeb5279a4
